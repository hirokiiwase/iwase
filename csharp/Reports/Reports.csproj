<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <AssemblyName>D365.Reports</AssemblyName>
    <RootNamespace>D365.Reports</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Dataverse / CRM SDK -->
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.49" />
    <!-- Excel 生成ライブラリ -->
    <PackageReference Include="ClosedXML" Version="0.102.2" />
  </ItemGroup>

  <!--
    デプロイ時は ILMerge / ILRepack で ClosedXML を本体 DLL に結合してから
    Plugin Registration Tool でアップロードする。
  -->

</Project>
